{
  "name": "@plume-ui-react/docs",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-api.mjs && node scripts/generate-stackblitz.mjs && node scripts/generate-bootstrap-scope.mjs && storybook dev -p 6006",
    "build": "node scripts/generate-api.mjs && node scripts/generate-stackblitz.mjs && node scripts/generate-bootstrap-scope.mjs && NODE_ENV=prod storybook build --docs",
    "preview-storybook": "serve storybook-static",
    "clean": "rm -rf .turbo && rm -rf node_modules",
    "lint": "node scripts/generate-stackblitz.mjs && eslint src/ && node scripts/generate-api.mjs && node scripts/check-api.mjs",
    "lint:fix": "node scripts/generate-stackblitz.mjs && eslint src/ --fix",
    "generate:api": "node scripts/generate-api.mjs",
    "generate:stackblitz": "node scripts/generate-stackblitz.mjs",
    "generate:bootstrap": "node scripts/generate-bootstrap-scope.mjs",
    "check:api": "node scripts/generate-api.mjs && node scripts/check-api.mjs"
  },
  "dependencies": {
    "plume-ui-react": "workspace:*"
  },
  "devDependencies": {
    "@stackblitz/sdk": "1.11.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-links": "^9.1.20",
    "@storybook/addon-themes": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/postcss": "^4.3.3",
    "bootstrap": "^5.3.1",
    "eslint-config-custom": "workspace:*",
    "prettier-config": "workspace:*",
    "react-docgen": "^7.0.3",
    "serve": "^13.0.4",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "tsconfig": "workspace:*",
    "vite": "^7.0.0"
  }
}
