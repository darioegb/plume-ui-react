{
  "name": "@plume-ui-react/lib",
  "version": "0.2.2",
  "description": "A lightweight TypeScript React UI component library",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup && node scripts/bundle-css.mjs",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darioegb/plume-ui-react.git"
  },
  "keywords": [
    "react",
    "typescript",
    "components",
    "lib",
    "ui",
    "design-system",
    "react-components",
    "uikit",
    "accessible",
    "plume-ui",
    "plume-ui-react"
  ],
  "author": "Dario E Gonzalez B <darioegb@gmail.com>",
  "dependencies": {
    "@plume-ui-react/button": "workspace:*",
    "@plume-ui-react/core": "workspace:*",
    "@plume-ui-react/datepicker": "workspace:*",
    "@plume-ui-react/input": "workspace:*",
    "@plume-ui-react/spinner": "workspace:*",
    "@plume-ui-react/tabs": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-config-custom": "workspace:*",
    "prettier-config": "workspace:*",
    "react": "^19.3.0",
    "tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "react": ">=16.11.0",
    "react-dom": ">=16.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
