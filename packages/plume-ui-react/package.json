{
  "name": "plume-ui-react",
  "version": "0.42.0",
  "description": "A lightweight TypeScript React UI component library, themed with CSS variables.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./css/*.css": "./dist/css/*.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/check-client-directives.mjs",
    "dev": "tsup --watch",
    "lint": "eslint src/ && stylelint \"src/**/*.module.css\" && node scripts/check-story-snippets.mjs",
    "lint:fix": "eslint src/ --fix",
    "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css tokens.css tailwind.css",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darioegb/plume-ui-react.git",
    "directory": "packages/plume-ui-react"
  },
  "homepage": "https://darioegb.github.io/plume-ui-react/",
  "bugs": "https://github.com/darioegb/plume-ui-react/issues",
  "keywords": [
    "react",
    "typescript",
    "components",
    "ui",
    "design-system",
    "react-components",
    "uikit",
    "accessible",
    "css-variables",
    "ssr",
    "plume-ui",
    "plume-ui-react"
  ],
  "author": "Dario E Gonzalez B <darioegb@gmail.com>",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.27.7",
    "eslint-config-custom": "workspace:*",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.29",
    "postcss-modules": "^6.0.0",
    "prettier-config": "workspace:*",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "7.89.0",
    "stylelint": "^17.16.0",
    "tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
