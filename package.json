{
  "name": "plume-ui-react",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/darioegb/plume-ui-react.git"
  },
  "author": "Dario E Gonzalez B",
  "license": "MIT",
  "version": "0.0.2",
  "scripts": {
    "build": "turbo run build --filter=@plume-ui-react/docs^...",
    "build:docs": "turbo run build  --filter=./apps/*",
    "build:examples": "turbo run build  --filter=./examples/*",
    "dev": "turbo run dev --no-cache --continue --filter=./apps/*",
    "lint": "turbo run lint --filter=@plume-ui-react/docs^...",
    "lint:fix": "turbo run lint:fix --filter=@plume-ui-react/docs^...",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changelog": "node scripts/changelog.js",
    "changelog:commit": "git add . && git commit -am 'docs: add changelog' && git push origin changelog/main",
    "changeset": "changeset",
    "test": "turbo run test --filter=@plume-ui-react/docs^...",
    "test:coverage": "turbo run test:coverage --filter=@plume-ui-react/docs^...",
    "test:watch": "turbo run test:watch --filter=@plume-ui-react/docs^...",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "postbuild": "find . -type f -name '*.mts' -exec rm {} +",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.4.8",
    "@changesets/cli": "^2.25.2",
    "@commitlint/cli": "^17.7.2",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/css-modules": "^1.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.48.0",
    "husky": "^9.1.7",
    "lint-staged": "^14.0.1",
    "postcss": "^8.4.29",
    "postcss-modules": "^6.0.0",
    "prettier": "^3.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "turbo": "^2.11.7",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@12.10.1"
}
